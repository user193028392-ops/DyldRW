#include <cstring>
#include <iostream>

int main() {
    constexpr size_t sizeofcmds = 0x100; // 256 bytes
    constexpr size_t cmdsize    = 0x20;  // 32 bytes

    char* buffer = new char[sizeofcmds];

    // Fill the allocated region so ASan can track its boundary.
    std::memset(buffer, 'A', sizeofcmds);

    char* cmd     = buffer;
    char* nextCmd = buffer + cmdsize;

    // Suspected calculation from the reported code:
    size_t bytesRemaining = sizeofcmds;

    std::cout << "dyldWR minimal memmove prototype\n";
    std::cout << "sizeofcmds: 0x" << std::hex << sizeofcmds << '\n';
    std::cout << "cmdsize:    0x" << cmdsize << '\n';
    std::cout << "source:     buffer + 0x" << (nextCmd - buffer) << '\n';
    std::cout << "copy size:  0x" << bytesRemaining << '\n';
    std::cout << "source end: 0x"
              << ((nextCmd - buffer) + bytesRemaining) << '\n';
    std::cout << "buffer end: 0x" << sizeofcmds << '\n';

    // Minimal reproduction of the suspected range:
    // destination = buffer
    // source      = buffer + 0x20
    // length      = 0x100
    //
    // The source range therefore extends to 0x120,
    // while the allocated buffer ends at 0x100.
    std::memmove(cmd, nextCmd, bytesRemaining);

    delete[] buffer;
    return 0;
}

